/target/
.claude/*
!.claude/commands/

# pixi environments (pixi.lock is committed)
.pixi/

# Large trajectories and model weights are never committed (see README for download steps)
*.dcd
*.nc
*.lammpstrj
*.traj
*.pt
*.pth
*.model
# Except the tiny random MACE test model of pimd-torch and its export (MILESTONE_6 decision 9;
# generated by crates/pimd-torch/tests/data/gen_tiny_mace.py, not third-party weights)
!/crates/pimd-torch/tests/data/tiny_mace.model
!/crates/pimd-torch/tests/data/tiny_mace_f64.pt
# M9a interface-v2 test exports of that model and small export-interface stubs
# (generated by crates/pimd-torch/tests/data/gen_tiny_mace_v2.py)
!/crates/pimd-torch/tests/data/tiny_mace_v2_f64.pt
!/crates/pimd-torch/tests/data/tiny_mace_bige0_v1_f64.pt
!/crates/pimd-torch/tests/data/tiny_mace_bige0_v2_f64.pt
!/crates/pimd-torch/tests/data/stub_v2_*.pt
# Owner-downloaded force-field weights (MACE-OFF23/24); never committed
/ff_models/

# Python bytecode
__pycache__/

# Validation run outputs (validation/run_neon.py, validation/benchmark.sh)
/validation/runs/

# Study run outputs (trajectories, exports, logs); results/ is committed
/studies/*/out/
